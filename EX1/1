	A=area(radius);
	printf("area:%2f\n ",A);
	
	c=circumference(radius);
	printf("circonference:%2f\n ",c);
	return 0;
}
float area(float radius)
 { 
	 return 3.14*radius*radius;
 }
float circumference(float radius)
{
	return 2*3.14*radius;
}
